{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "finalprojectsecurity/book-marketplace-backend/**"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/finalprojectsecurity/book-marketplace-frontend/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/finalprojectsecurity/book-marketplace-frontend/$1"
    }
  ]
}
