{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "finalprojectsecurity/book-marketplace-backend/api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/finalprojectsecurity/book-marketplace-backend/api/$1"
    },
    {
      "source": "/",
      "destination": "/finalprojectsecurity/book-marketplace-frontend/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/finalprojectsecurity/book-marketplace-frontend/$1"
    }
  ]
}
