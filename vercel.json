{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "book-marketplace-backend/**",
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/robots.txt", "dest": "/api/index.php?__route=robots.php" },
    { "src": "/sitemap.xml", "dest": "/api/index.php?__route=sitemap.php" },
    { "src": "^/home(\\.html)?$", "status": 301, "headers": { "Location": "/" } },
    { "src": "^/(books|catalog|marketplace|shop)$", "status": 301, "headers": { "Location": "/browse.html" } },
    { "src": "^/(signin|sign-in)$", "status": 301, "headers": { "Location": "/login.html" } },
    { "src": "^/(signup|sign-up)$", "status": 301, "headers": { "Location": "/register.html" } },
    { "src": "^/(sell|list)$", "status": 301, "headers": { "Location": "/list-book.html" } },
    { "src": "^/(orders|history)$", "status": 301, "headers": { "Location": "/transactions.html" } },
    { "src": "^/(help|contact)$", "status": 301, "headers": { "Location": "/support.html" } },
    { "src": "^/refunds$", "status": 301, "headers": { "Location": "/refund.html" } },
    { "src": "^/reports$", "status": 301, "headers": { "Location": "/report.html" } },
    { "src": "^/browse$", "status": 301, "headers": { "Location": "/browse.html" } },
    { "src": "^/login$", "status": 301, "headers": { "Location": "/login.html" } },
    { "src": "^/register$", "status": 301, "headers": { "Location": "/register.html" } },
    { "src": "^/list-book$", "status": 301, "headers": { "Location": "/list-book.html" } },
    { "src": "^/transactions$", "status": 301, "headers": { "Location": "/transactions.html" } },
    { "src": "^/support$", "status": 301, "headers": { "Location": "/support.html" } },
    { "src": "^/refund$", "status": 301, "headers": { "Location": "/refund.html" } },
    { "src": "^/report$", "status": 301, "headers": { "Location": "/report.html" } },
    { "src": "^/dashboard$", "status": 301, "headers": { "Location": "/dashboard.html" } },
    { "src": "^/customer-dashboard$", "status": 301, "headers": { "Location": "/customer-dashboard.html" } },
    { "src": "^/admin$", "status": 301, "headers": { "Location": "/admin.html" } },
    { "src": "^/staff$", "status": 301, "headers": { "Location": "/staff.html" } },
    { "src": "^/forgot-password$", "status": 301, "headers": { "Location": "/forgot-password.html" } },
    { "src": "^/reset-password$", "status": 301, "headers": { "Location": "/reset-password.html" } },
    { "src": "^/verify-email$", "status": 301, "headers": { "Location": "/verify-email.html" } },
    { "src": "/api/?(.*)", "dest": "/api/index.php?__route=$1" },
    { "src": "/", "dest": "/book-marketplace-frontend/index.html" },
    { "src": "/404(\\.html)?", "dest": "/book-marketplace-frontend/404.html" },
    { "src": "/(.*)", "dest": "/book-marketplace-frontend/$1" }
  ],
  "headers": [
    {
      "source": "/(.*\\.(css|js|svg|png|jpg|jpeg|woff2|ico))$",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
